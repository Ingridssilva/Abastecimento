# Copie este arquivo para ".env" e preencha com seus próprios valores.
# Nunca faça commit do arquivo ".env" real (ele já está no .gitignore).

NODE_ENV=development
PORT=3000

# --- Banco de dados (PostgreSQL / Supabase) ---
DATABASE_URL=postgresql://usuario:senha@host:5432/nome_do_banco

# --- Sessão / autenticação ---
JWT_SECRET=troque-por-uma-chave-secreta-longa-e-aleatoria

# --- URLs da aplicação ---
FRONTEND_URL=http://localhost:5500
SYSTEM_URL=http://localhost:3000

# --- Microsoft OAuth2 / Graph API (login SSO e SharePoint) ---
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# --- SharePoint (armazenamento de comprovantes/relatórios) ---
SHAREPOINT_SITE_ID=
SHAREPOINT_ROOT_FOLDER=Departamento de Frotas/SETOR DE FROTA/SISTEMA ABASTECIMENTO

# --- Notificações por e-mail ---
EMAIL_FROM=ti@empresaexemplo.com.br
EMAIL_GESTORES=frotas@empresaexemplo.com.br
